# Copy to .env.local and fill in. Never commit .env.local.
# Reference: spec/platform.md Appendix B.

# ---- Supabase ----------------------------------------------------------
# Settings -> API. The anon key is client-side and RLS-protected.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Database: two URLs, not one (spec/platform.md §16.2) -----------------------
# Supabase's direct host is IPv6-only on the free plan and Vercel is IPv4,
# so both of these go through the pooler, on different ports and modes.
# If the password contains @ : / ? # & — percent-encode it.
#
# App runtime. Transaction pooler, port 6543. Requires prepare:false.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations only. Session pooler, port 5432.
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- Test database: a SEPARATE file, .env.test.local (local.md §6.1) ----
# `pnpm test` truncates all 21 tables, so it must never see the URLs above.
# Put these two lines in `.env.test.local`, which vitest loads first:
#
#   DATABASE_URL=postgresql://postgres@localhost:55432/zetix
#   DIRECT_URL=postgresql://postgres@localhost:55432/zetix
#
# tests/helpers/db.ts rejects any non-local hostname, so a missing
# .env.test.local fails loudly rather than emptying production.

# ---- App ---------------------------------------------------------------
# Baked into every QR at issue time and unrecallable (spec/tickets.md §10.1).
# The Vercel PRODUCTION ALIAS — never a deployment URL, never VERCEL_URL.
# Locally: http://localhost:3000
APP_URL=https://<project>.vercel.app

# Shared secret for /api/health and the dispatch route: openssl rand -base64 32
CRON_SECRET=

# ---- Admin (spec/admin.md §14.3) ---------------------------------------------
# The constant address behind the code-only admin login.
ADMIN_EMAIL=
# Initial shared admin code; read only by scripts/bootstrap-admin.ts.
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Email (spec/email.md §11.1) — needed from ~12 Sep -----------------------
GMAIL_USER=
# App password, not the account password. Requires 2FA.
GMAIL_APP_PASSWORD=

# ---- Ticket artwork (spec/tickets.md §10.3) ----------------------------
# Where uploaded template backgrounds and images are stored.
# UNSET in production: artwork goes to the private Supabase Storage bucket
# `ticket-assets` (local.md §8), read with the service role.
# SET in development, tests and CI: a local directory, because there is no
# route from a cloud container to a bucket's contents and no service-role key
# in one (local.md §7). Anything outside the repo works; keep it out of git.
# TICKET_ASSET_DIR=.ticket-assets

# ---- Local development only --------------------------------------------
# scripts/local-db.sh writes this; the allocation engine is developed against
# a local Postgres 16, not Supabase (spec/platform.md §16.4).
# DATABASE_URL=postgresql://postgres@localhost:55432/zetix
