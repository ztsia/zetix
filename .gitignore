# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local
.env*.local
.env
!.env.example

# local postgres
.zetix-pgdata/

# qa run artifacts (screenshots, traces, reports)
qa-artifacts/

# the demo video's Remotion edit: its own project, raw footage and renders
# (spec/v3.md §31). Never in git, so never in the public history either.
video-edit/

# uploaded ticket artwork, when TICKET_ASSET_DIR points inside the repo
# (spec/tickets.md §10.3). Production uses the Supabase bucket instead.
.ticket-assets/
